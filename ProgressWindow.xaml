<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EveryCopy.ProgressWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:EveryCopy.Models"
    xmlns:local="using:EveryCopy">

    <Grid x:Name="Root" Background="{ThemeResource CanvasBrush}" Padding="14,12,14,10" RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- One card per transfer, each in its drive's colour -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0">
            <ItemsControl x:Name="JobsList" Margin="0,0,8,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:CopyJob">
                        <Grid Background="{ThemeResource TileBrush}" BorderBrush="{ThemeResource BorderBrush1}" BorderThickness="1"
                              CornerRadius="8" Padding="16,10,10,6" Margin="0,0,0,8" RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- The drive's colour down the left edge -->
                            <Border Grid.RowSpan="6" HorizontalAlignment="Left" Width="5" Margin="-16,-10,0,-6" CornerRadius="8,0,0,8"
                                    Background="{x:Bind local:Tints.BrushOf(DestColor), Mode=OneWay}" />

                            <!-- Which drive (colour + name), status, percentage -->
                            <Grid Grid.Row="0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MaxWidth="230" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource GhostButton}" Tag="{x:Bind}" Click="Rename_Click" Padding="8,2" MinHeight="28"
                                        Background="{x:Bind local:Tints.SoftBrushOf(DestColor), Mode=OneWay}"
                                        ToolTipService.ToolTip="Click to name this drive or change its colour">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="11" Height="11" Fill="{x:Bind local:Tints.BrushOf(DestColor), Mode=OneWay}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind DestLabel, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                                <Border Grid.Column="2" Background="{ThemeResource AccentTintBrush}" CornerRadius="10" Padding="9,2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="11" />
                                </Border>
                                <TextBlock Grid.Column="3" Text="{x:Bind PercentText, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{x:Bind local:Tints.BrushOf(DestColor), Mode=OneWay}" />
                            </Grid>

                            <!-- Source name, destination name -->
                            <Grid Grid.Row="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MaxWidth="190" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind FromName, Mode=OneWay}" TextReadingOrder="DetectFromContent" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind FromTip, Mode=OneWay}" />
                                <FontIcon Grid.Column="1" Glyph="&#xE72A;" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind ToName, Mode=OneWay}" TextReadingOrder="DetectFromContent" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{x:Bind local:Tints.BrushOf(DestColor), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ToPath, Mode=OneWay}" />
                            </Grid>

                            <ProgressBar Grid.Row="2" Minimum="0" Maximum="100" Value="{x:Bind Percent, Mode=OneWay}"
                                         Foreground="{x:Bind local:Tints.BrushOf(DestColor), Mode=OneWay}"
                                         IsIndeterminate="{x:Bind IsScanning, Mode=OneWay}" ShowPaused="{x:Bind IsPaused, Mode=OneWay}" />

                            <!-- Speed, size, time left -->
                            <Grid Grid.Row="3" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Detail, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1" Text="{x:Bind SpeedText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Top" />
                            </Grid>

                            <!-- Detailed layout only -->
                            <StackPanel Grid.Row="4" Spacing="8" Visibility="{x:Bind ShowDetails, Mode=OneWay}" Margin="0,2,0,0">
                                <Grid ColumnSpacing="8" RowSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="FROM" Style="{StaticResource PanelHeader}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind FromPath, Mode=OneWay}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="1" Text="TO" Style="{StaticResource PanelHeader}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ToPath, Mode=OneWay}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <local:SpeedGraph Samples="{x:Bind SpeedHistory, Mode=OneWay}" Tint="{x:Bind local:Tints.ColorOf(DestColor), Mode=OneWay}" />

                                <TextBlock Text="{x:Bind Current, Mode=OneWay}" TextReadingOrder="DetectFromContent" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ErrorsLabel, Mode=OneWay}" Foreground="#E5484D" FontSize="12" Visibility="{x:Bind HasErrors, Mode=OneWay}" />

                                <TextBlock Text="{x:Bind ItemsHeader, Mode=OneWay}" Style="{StaticResource PanelHeader}" />
                                <ItemsControl ItemsSource="{x:Bind Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="m:JobItem">
                                            <Grid Height="36" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="{ThemeResource TextMutedBrush}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextReadingOrder="DetectFromContent" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind RemovedLabel, Mode=OneWay}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                                <Button Grid.Column="3" Style="{StaticResource ToolButton}" Width="30" Height="30" MinHeight="30" Tag="{x:Bind}" Click="RemoveItem_Click"
                                                        Visibility="{x:Bind CanRemove, Mode=OneWay}" ToolTipService.ToolTip="Remove this item from the transfer (stops it if it is being copied)">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Buttons -->
                            <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="2" Margin="-8,0,0,0">
                                <Button Style="{StaticResource ToolButton}" Width="34" Height="34" Tag="{x:Bind}" Click="Pause_Click"
                                        Visibility="{x:Bind CanPause, Mode=OneWay}" ToolTipService.ToolTip="Pause">
                                    <FontIcon Glyph="&#xE769;" FontSize="14" />
                                </Button>
                                <Button Style="{StaticResource ToolButton}" Width="34" Height="34" Tag="{x:Bind}" Click="Resume_Click"
                                        Visibility="{x:Bind CanResume, Mode=OneWay}" ToolTipService.ToolTip="Resume">
                                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                                </Button>
                                <Button Style="{StaticResource ToolButton}" Width="34" Height="34" Tag="{x:Bind}" Click="Cancel_Click"
                                        Visibility="{x:Bind CanCancel, Mode=OneWay}" ToolTipService.ToolTip="Cancel this transfer">
                                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                                </Button>
                                <Button Style="{StaticResource ToolButton}" Width="34" Height="34" Tag="{x:Bind}" Click="SkipFile_Click"
                                        Visibility="{x:Bind CanSkipFile, Mode=OneWay}" ToolTipService.ToolTip="Skip the file being copied now">
                                    <FontIcon Glyph="&#xE893;" FontSize="14" />
                                </Button>
                                <Button Style="{StaticResource ToolButton}" Width="34" Height="34" Tag="{x:Bind}" Click="OpenFolder_Click"
                                        ToolTipService.ToolTip="Open the destination folder">
                                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="1" Margin="-8,0,-8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SummaryText" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                <Button Style="{StaticResource GhostButton}" MinHeight="32" Click="OpenApp_Click" ToolTipService.ToolTip="Open the EveryCopy window with the whole queue">
                    <TextBlock Text="Open EveryCopy" />
                </Button>
                <Button Style="{StaticResource GhostButton}" MinHeight="32" Click="Mode_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="ModeText" />
                        <FontIcon x:Name="ModeIcon" FontSize="11" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
